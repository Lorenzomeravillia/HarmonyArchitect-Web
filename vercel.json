{
  "git": {
    "deploymentEnabled": {
      "claude/chord-logic-analysis-e1iv0t": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/WebVersion/index.html"
    },
    {
      "source": "/rullo",
      "destination": "/apps/rullo/index.html"
    },
    {
      "source": "/rullo/",
      "destination": "/apps/rullo/index.html"
    },
    {
      "source": "/rullo/(.*)",
      "destination": "/apps/rullo/$1"
    },
    {
      "source": "/sirena",
      "destination": "/apps/sirena/index.html"
    },
    {
      "source": "/sirena/",
      "destination": "/apps/sirena/index.html"
    },
    {
      "source": "/sirena/(.*)",
      "destination": "/apps/sirena/$1"
    },
    {
      "source": "/bimbi",
      "destination": "/apps/bimbi/index.html"
    },
    {
      "source": "/bimbi/",
      "destination": "/apps/bimbi/index.html"
    },
    {
      "source": "/bimbi/(.*)",
      "destination": "/apps/bimbi/$1"
    },
    {
      "source": "/test-microfono",
      "destination": "/apps/test-microfono/index.html"
    },
    {
      "source": "/test-microfono/",
      "destination": "/apps/test-microfono/index.html"
    },
    {
      "source": "/test-microfono/(.*)",
      "destination": "/apps/test-microfono/$1"
    },
    {
      "source": "/shared/(.*)",
      "destination": "/apps/shared/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/WebVersion/$1"
    }
  ],
  "headers": [
    {
      "source": "/WebVersion/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/test-microfono",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/bimbi",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sirena",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/rullo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/WebVersion/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/WebVersion/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/WebVersion/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/WebVersion/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pitch-roll.html",
      "destination": "/rullo",
      "permanent": false
    },
    {
      "source": "/sirena.html",
      "destination": "/sirena",
      "permanent": false
    },
    {
      "source": "/bimbi.html",
      "destination": "/bimbi",
      "permanent": false
    },
    {
      "source": "/mic-test.html",
      "destination": "/test-microfono",
      "permanent": false
    },
    {
      "source": "/bimbi.webmanifest",
      "destination": "/bimbi/manifest.webmanifest",
      "permanent": false
    }
  ]
}
